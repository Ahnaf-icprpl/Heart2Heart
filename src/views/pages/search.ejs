<div style="max-width: 820px; margin: 0 auto;">
  <!-- Search Header -->
  <div style="margin-bottom: 1.75rem;">
    <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
      <span>🔍</span>
      <span>Search Results <%= query ? `for "${query}"` : '' %></span>
    </h1>
    <p style="font-size: 0.88rem; color: var(--text-muted); margin-top: 0.25rem;">
      Finding empathetic stories, feelings, and support circles.
    </p>
  </div>

  <!-- Search Form Bar -->
  <form action="/search" method="GET" style="margin-bottom: 1.75rem;">
    <div class="search-form-row">
      <input 
        type="search" 
        name="q" 
        value="<%= query %>" 
        class="form-input" 
        placeholder="Type a feeling, topic (e.g. anxiety, burnout, heartbreak), or tag..." 
        style="flex: 1;"
        required
      >
      <button type="submit" class="btn btn-primary">Search</button>
    </div>
  </form>

  <!-- Matching Circles Section (if any) -->
  <% if (matchingCircles && matchingCircles.length > 0) { %>
    <div style="margin-bottom: 2rem;">
      <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--secondary);">
        🫧 Matching Support Circles
      </h3>
      <div class="search-circles-grid">
        <% matchingCircles.forEach(circle => { %>
          <a href="/circles/<%= circle.id %>" class="card" style="padding: 1rem; display: flex; align-items: center; gap: 0.75rem; transition: var(--transition);">
            <span style="font-size: 1.8rem;"><%= circle.icon %></span>
            <div>
              <div style="font-weight: 700; font-size: 0.95rem;"><%= circle.name %></div>
              <div style="font-size: 0.8rem; color: var(--text-muted);"><%= circle.memberCount %> members</div>
            </div>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Matching Posts Section -->
  <div>
    <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-main);">
      📝 Stories (<%= posts.length %>)
    </h3>

    <% if (posts && posts.length > 0) { %>
      <% posts.forEach(post => { %>
        <%- include('../partials/post-card', { post }) %>
      <% }); %>
    <% } else { %>
      <div class="card" style="text-align: center; padding: 3rem 1.5rem; color: var(--text-muted);">
        <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🌿</div>
        <h4 style="font-weight: 700; font-size: 1.1rem; margin-bottom: 0.4rem;">No matching stories found</h4>
        <p style="font-size: 0.88rem; max-width: 400px; margin: 0 auto 1.25rem;">
          Try searching for words like "anxiety", "burnout", "perfectionism", "loneliness", or browse by mood.
        </p>
        <a href="/moods" class="btn btn-secondary">Explore Feelings Directory</a>
      </div>
    <% } %>
  </div>
</div>
