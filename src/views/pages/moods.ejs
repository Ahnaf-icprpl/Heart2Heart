<div style="max-width: 860px; margin: 0 auto;">
  <!-- Header -->
  <div style="margin-bottom: 2rem;">
    <h1 style="font-size: 1.6rem; font-weight: 800; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
      <span>🌈</span>
      <span>Feelings & Emotional Landscape</span>
    </h1>
    <p style="font-size: 0.95rem; color: var(--text-muted); margin-top: 0.35rem;">
      Emotions are not good or bad — they are signals asking for our attention and care. Explore what others are experiencing or share what you are carrying.
    </p>
  </div>

  <!-- Mood Groups Stream -->
  <div style="display: flex; flex-direction: column; gap: 1.75rem;">
    <% moodGroups.forEach(group => { %>
      <div class="card mood-group-card">
        <div class="mood-group-header">
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span style="font-size: 1.8rem;"><%= group.emoji %></span>
            <div>
              <h2 style="font-size: 1.2rem; font-weight: 800; color: var(--text-main);"><%= group.name %></h2>
              <p style="font-size: 0.82rem; color: var(--text-muted);"><%= group.desc %></p>
            </div>
          </div>

          <div class="mood-group-actions">
            <a href="/posts/new?mood=<%= encodeURIComponent(group.name) %>" class="btn btn-pill-subtle" style="font-size: 0.78rem;">
              <span>+ Share in <%= group.name %></span>
            </a>
            <a href="/?mood=<%= encodeURIComponent(group.name) %>" class="btn btn-secondary" style="font-size: 0.78rem;">
              <span>View All (<%= group.totalCount %>)</span>
            </a>
          </div>
        </div>

        <!-- Preview Stories -->
        <% if (group.posts && group.posts.length > 0) { %>
          <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; border-top: 1px solid var(--border-color); padding-top: 0.75rem;">
            <% group.posts.forEach(post => { %>
              <a href="/posts/<%= post.id %>" style="display: block; padding: 0.75rem; border-radius: var(--radius-md); background-color: var(--bg-surface-subtle); transition: var(--transition);">
                <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-main); margin-bottom: 0.2rem;">
                  <%= post.title %>
                </div>
                <div style="font-size: 0.82rem; color: var(--text-muted); display: flex; align-items: center; gap: 0.6rem;">
                  <span>by <%= post.authorName %></span>
                  <span>•</span>
                  <span>❤️ <%= post.reactions.hug || 0 %> hugs</span>
                  <span>•</span>
                  <span>💬 <%= post.comments ? post.comments.length : 0 %> comments</span>
                </div>
              </a>
            <% }); %>
          </div>
        <% } else { %>
          <div style="font-size: 0.85rem; color: var(--text-light); margin-top: 0.5rem; font-style: italic;">
            No stories shared under <%= group.name %> yet.
          </div>
        <% } %>
      </div>
    <% }); %>
  </div>
</div>
