<div style="max-width: 860px; margin: 0 auto;">
  <!-- Profile Hero Header -->
  <div class="card profile-hero-card">
    <div class="profile-header-main">
      <div class="profile-user-info-row">
        <div class="profile-avatar-lg" style="background-color: <%= user.avatarBg %>;">
          <%= user.avatar %>
        </div>

        <div class="profile-meta-wrap">
          <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
            <h1 style="font-size: 1.5rem; font-weight: 800;"><%= user.name %></h1>
            <% if (user.pronouns) { %>
              <span style="font-size: 0.8rem; background-color: var(--bg-surface-subtle); padding: 0.15rem 0.5rem; border-radius: var(--radius-full); color: var(--text-light);"><%= user.pronouns %></span>
            <% } %>
          </div>
          <div style="font-size: 0.88rem; color: var(--text-light); margin-top: 0.15rem;">
            @<%= user.handle %> • <%= user.joinedDate %>
          </div>
          <p style="font-size: 0.95rem; color: var(--text-main); margin-top: 0.6rem; max-width: 500px;">
            <%= user.bio || 'Sharing light, empathy, and safe reflections on Heart2Heart.' %>
          </p>
        </div>
      </div>

      <% if (isSelf) { %>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <button type="button" class="btn btn-secondary" onclick="document.getElementById('edit-profile-box').style.display = document.getElementById('edit-profile-box').style.display === 'none' ? 'block' : 'none'">
            <span>✏️ Edit Bio</span>
          </button>
        </div>
      <% } %>
    </div>

    <!-- Empathy Stats Row -->
    <div class="profile-stats-grid">
      <div style="background-color: var(--bg-surface-subtle); padding: 0.85rem; border-radius: var(--radius-md); text-align: center;">
        <div style="font-size: 1.3rem; font-weight: 800; color: var(--primary);"><%= user.hugsGiven || 0 %></div>
        <div style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600;">Hugs Given ❤️</div>
      </div>
      <div style="background-color: var(--bg-surface-subtle); padding: 0.85rem; border-radius: var(--radius-md); text-align: center;">
        <div style="font-size: 1.3rem; font-weight: 800; color: var(--secondary);"><%= user.hugsReceived || 0 %></div>
        <div style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600;">Hugs Received 🤗</div>
      </div>
      <div style="background-color: var(--bg-surface-subtle); padding: 0.85rem; border-radius: var(--radius-md); text-align: center;">
        <div style="font-size: 1.3rem; font-weight: 800; color: var(--accent-teal);"><%= myPosts.length %></div>
        <div style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600;">Stories Shared 📝</div>
      </div>
      <div style="background-color: var(--bg-surface-subtle); padding: 0.85rem; border-radius: var(--radius-md); text-align: center;">
        <div style="font-size: 1.3rem; font-weight: 800; color: var(--accent-amber);"><%= user.circlesJoined ? user.circlesJoined.length : 0 %></div>
        <div style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600;">Circles Joined 🫧</div>
      </div>
    </div>
  </div>

  <!-- Edit Profile Collapsible Form -->
  <% if (isSelf) { %>
    <div id="edit-profile-box" class="card" style="display: none; margin-bottom: 1.75rem; border-left: 4px solid var(--primary);">
      <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem;">Update Your Profile</h3>
      <form action="/profile/edit" method="POST">
        <div class="form-group">
          <label class="form-label">Display Name</label>
          <input type="text" name="name" class="form-input" value="<%= user.name %>" required>
        </div>
        <div class="form-group">
          <label class="form-label">Pronouns</label>
          <input type="text" name="pronouns" class="form-input" value="<%= user.pronouns || '' %>" placeholder="e.g. she/her, they/them, he/him">
        </div>
        <div class="form-group">
          <label class="form-label">Bio</label>
          <textarea name="bio" class="form-textarea" style="min-height: 80px;"><%= user.bio || '' %></textarea>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 0.5rem;">
          <button type="button" class="btn btn-secondary" onclick="document.getElementById('edit-profile-box').style.display='none'">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
  <% } %>

  <!-- Mood History (Private to self) -->
  <% if (isSelf && moodHistory && moodHistory.length > 0) { %>
    <div class="card" style="margin-bottom: 1.75rem;">
      <div class="card-title" style="justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span>📈</span>
          <span>Recent Heart Check-In History</span>
        </div>
        <button type="button" class="btn btn-pill-subtle" style="font-size: 0.78rem;" data-open-mood-modal>
          + Check In
        </button>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.6rem;">
        <% moodHistory.slice(0, 5).forEach(m => { %>
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0.85rem; background-color: var(--bg-surface-subtle); border-radius: var(--radius-md);">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
              <span style="font-size: 1.3rem;"><%= m.moodEmoji %></span>
              <div>
                <span style="font-weight: 700; font-size: 0.88rem;"><%= m.moodLabel %></span>
                <% if (m.note) { %>
                  <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.1rem;">"<%= m.note %>"</p>
                <% } %>
              </div>
            </div>
            <span style="font-size: 0.75rem; color: var(--text-light);"><%= timeAgo(m.timestamp) %></span>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Stories Feed Navigation Tabs -->
  <div class="profile-tabs-bar">
    <button type="button" id="tab-my-posts-btn" class="filter-chip active" onclick="switchProfileTab('posts')">
      <span>📝</span>
      <span><%= isSelf ? 'My Shared Stories' : `${user.name}'s Stories` %> (<%= myPosts.length %>)</span>
    </button>
    <% if (isSelf) { %>
      <button type="button" id="tab-bookmarks-btn" class="filter-chip" onclick="switchProfileTab('bookmarks')">
        <span>🔖</span>
        <span>Saved Stories (<%= bookmarkedPosts.length %>)</span>
      </button>
    <% } %>
  </div>

  <!-- Shared Stories Tab Content -->
  <div id="profile-posts-view">
    <% if (myPosts && myPosts.length > 0) { %>
      <% myPosts.forEach(post => { %>
        <%- include('../partials/post-card', { post }) %>
      <% }); %>
    <% } else { %>
      <div class="card" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
        <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🍃</div>
        <p>No stories shared yet.</p>
        <% if (isSelf) { %>
          <a href="/posts/new" class="btn btn-primary" style="margin-top: 0.75rem;">Share What's on Your Heart</a>
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- Bookmarks Tab Content (if self) -->
  <% if (isSelf) { %>
    <div id="profile-bookmarks-view" style="display: none;">
      <% if (bookmarkedPosts && bookmarkedPosts.length > 0) { %>
        <% bookmarkedPosts.forEach(post => { %>
          <%- include('../partials/post-card', { post }) %>
        <% }); %>
      <% } else { %>
        <div class="card" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
          <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🔖</div>
          <p>You haven't saved any comforting stories yet. Click the bookmark icon on any post to keep it here.</p>
          <a href="/" class="btn btn-secondary" style="margin-top: 0.75rem;">Explore Safe Feed</a>
        </div>
      <% } %>
    </div>

    <script>
      function switchProfileTab(tab) {
        const postsView = document.getElementById('profile-posts-view');
        const bookmarksView = document.getElementById('profile-bookmarks-view');
        const postBtn = document.getElementById('tab-my-posts-btn');
        const bookBtn = document.getElementById('tab-bookmarks-btn');

        if (tab === 'posts') {
          postsView.style.display = 'block';
          bookmarksView.style.display = 'none';
          postBtn.classList.add('active');
          bookBtn.classList.remove('active');
        } else {
          postsView.style.display = 'none';
          bookmarksView.style.display = 'block';
          postBtn.classList.remove('active');
          bookBtn.classList.add('active');
        }
      }
    </script>
  <% } %>
</div>
