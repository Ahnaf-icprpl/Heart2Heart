<div class="breathing-page" id="breathing-room-app">
  <!-- Header -->
  <div>
    <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text-main); display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
      <span>🫁</span>
      <span>Peaceful Breathing Room</span>
    </h1>
    <p style="font-size: 0.95rem; color: var(--text-muted); margin-top: 0.35rem;">
      When thoughts spiral or anxiety tightens your chest, conscious breathing signals safety directly to your nervous system.
    </p>
  </div>

  <!-- Technique Selector -->
  <div class="technique-selector" style="margin-top: 1.5rem;">
    <button type="button" class="filter-chip active" data-breathing-tech="4-7-8">
      <span>🌙</span>
      <span>4-7-8 Relaxing Breath</span>
    </button>
    <button type="button" class="filter-chip" data-breathing-tech="box">
      <span>📦</span>
      <span>Box Breathing (4-4-4-4)</span>
    </button>
    <button type="button" class="filter-chip" data-breathing-tech="calm">
      <span>🌊</span>
      <span>Deep Calming (5-5)</span>
    </button>
  </div>

  <!-- Interactive Visualizer -->
  <div class="breathing-box">
    <div class="breathing-visual-container">
      <div class="breathing-circle-outer" id="breathing-circle-outer"></div>
      <div class="breathing-circle-inner" id="breathing-circle-inner">
        <div class="breathing-instruction" id="breathing-instruction">Ready</div>
        <div class="breathing-timer" id="breathing-timer">🌸</div>
      </div>
    </div>

    <!-- Control Buttons -->
    <div class="breathing-controls">
      <button type="button" class="btn btn-primary" id="breathing-start-btn" style="padding: 0.75rem 2rem; font-size: 1rem;">
        <span>▶ Start Breathing</span>
      </button>
      <button type="button" class="btn btn-secondary" id="breathing-stop-btn" style="display: none; padding: 0.75rem 2rem; font-size: 1rem;">
        <span>⏹ Pause / Reset</span>
      </button>
    </div>
  </div>

  <!-- Tips and guidance -->
  <div class="card" style="text-align: left; max-width: 580px; margin: 0 auto; background-color: var(--bg-surface-subtle);">
    <div style="font-weight: 700; font-size: 0.95rem; margin-bottom: 0.4rem; color: var(--primary);">
      💡 Tips for this exercise
    </div>
    <ul style="padding-left: 1.25rem; font-size: 0.88rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.35rem;">
      <li>Place one hand on your chest and one on your belly. Try to breathe from your belly.</li>
      <li>If you lose the rhythm, don't worry. Just resume whenever you're ready.</li>
      <li>Even 2 minutes of synchronized breathing noticeably lowers your resting heart rate.</li>
    </ul>
  </div>
</div>
