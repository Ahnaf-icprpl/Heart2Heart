<div class="modal-overlay" id="mood-checkin-modal">
  <div class="modal-content">
    <div class="modal-header">
      <div class="modal-title">
        <span>💖</span>
        <span>Check in with your heart</span>
      </div>
      <button type="button" class="modal-close-btn" id="close-mood-modal">✕</button>
    </div>

    <form action="/profile/mood" method="POST">
      <input type="hidden" name="moodValue" id="modal-mood-value" value="3">
      <input type="hidden" name="moodLabel" id="modal-mood-label" value="Okay / Getting By">
      <input type="hidden" name="moodEmoji" id="modal-mood-emoji" value="🌱">
      <input type="hidden" name="returnTo" value="<%= activePath %>">

      <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.25rem;">
        Take a gentle moment to pause. There is no right or wrong answer here — just acknowledge where you are right now.
      </p>

      <label class="form-label">How would you describe your emotional state?</label>
      <div class="mood-selector-row" style="margin-bottom: 1.5rem;">
        <button type="button" class="mood-btn modal-mood-pill" data-mood-val="1" data-mood-name="Heavy / Struggling" data-mood-emoji="🌧️">
          <span class="mood-emoji">🌧️</span>
          <span class="mood-label">Heavy</span>
        </button>
        <button type="button" class="mood-btn modal-mood-pill" data-mood-val="2" data-mood-name="Tired / Drained" data-mood-emoji="😮‍💨">
          <span class="mood-emoji">😮‍💨</span>
          <span class="mood-label">Tired</span>
        </button>
        <button type="button" class="mood-btn modal-mood-pill selected" data-mood-val="3" data-mood-name="Okay / Getting By" data-mood-emoji="🌱">
          <span class="mood-emoji">🌱</span>
          <span class="mood-label">Okay</span>
        </button>
        <button type="button" class="mood-btn modal-mood-pill" data-mood-val="4" data-mood-name="Gentle / Peaceful" data-mood-emoji="✨">
          <span class="mood-emoji">✨</span>
          <span class="mood-label">Gentle</span>
        </button>
        <button type="button" class="mood-btn modal-mood-pill" data-mood-val="5" data-mood-name="Grateful / Bright" data-mood-emoji="☀️">
          <span class="mood-emoji">☀️</span>
          <span class="mood-label">Bright</span>
        </button>
      </div>

      <div class="form-group">
        <label for="mood-note" class="form-label">Optional journal note (Private to your space)</label>
        <textarea 
          name="note" 
          id="mood-note" 
          class="form-textarea" 
          style="min-height: 80px;" 
          placeholder="A word, a sigh, or what is occupying your thoughts..."
        ></textarea>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('mood-checkin-modal').classList.remove('show')">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Heart Check-In</button>
      </div>
    </form>
  </div>
</div>
