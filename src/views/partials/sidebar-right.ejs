<aside class="sidebar-right">
  <!-- Interactive Mood Check-In Widget -->
  <div class="card mood-checkin-card" style="margin-bottom: 1.25rem;">
    <div class="card-title">
      <span>💖</span>
      <span>How's your heart today?</span>
    </div>
    
    <div class="mood-selector-row">
      <button type="button" class="mood-btn" data-open-mood-modal data-mood-val="1" data-mood-label="Heavy" data-mood-emoji="🌧️" title="Heavy / Struggling">
        <span class="mood-emoji">🌧️</span>
        <span class="mood-label">Heavy</span>
      </button>
      <button type="button" class="mood-btn" data-open-mood-modal data-mood-val="2" data-mood-label="Tired" data-mood-emoji="😮‍💨" title="Tired / Exhausted">
        <span class="mood-emoji">😮‍💨</span>
        <span class="mood-label">Tired</span>
      </button>
      <button type="button" class="mood-btn" data-open-mood-modal data-mood-val="3" data-mood-label="Okay" data-mood-emoji="🌱" title="Okay / Getting By">
        <span class="mood-emoji">🌱</span>
        <span class="mood-label">Okay</span>
      </button>
      <button type="button" class="mood-btn" data-open-mood-modal data-mood-val="4" data-mood-label="Gentle" data-mood-emoji="✨" title="Gentle / Peaceful">
        <span class="mood-emoji">✨</span>
        <span class="mood-label">Gentle</span>
      </button>
      <button type="button" class="mood-btn" data-open-mood-modal data-mood-val="5" data-mood-label="Grateful" data-mood-emoji="☀️" title="Grateful / Bright">
        <span class="mood-emoji">☀️</span>
        <span class="mood-label">Bright</span>
      </button>
    </div>

    <button type="button" class="btn btn-secondary" style="width: 100%; font-size: 0.82rem; padding: 0.4rem;" data-open-mood-modal>
      <span>📝 Log Heart Check-In</span>
    </button>
  </div>

  <!-- Daily Affirmation Card -->
  <% if (dailyAffirmation) { %>
    <div class="card affirmation-card" style="margin-bottom: 1.25rem;">
      <div class="card-title" style="color: var(--primary); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">
        <span>✨</span>
        <span>Comfort for Your Soul</span>
      </div>
      <p class="affirmation-quote">"<%= dailyAffirmation.quote %>"</p>
      <div class="affirmation-author">— <%= dailyAffirmation.author %></div>
    </div>
  <% } %>

  <!-- Support Circles Highlights -->
  <div class="card" style="margin-bottom: 1.25rem;">
    <div class="card-title" style="justify-content: space-between;">
      <div style="display: flex; align-items: center; gap: 0.4rem;">
        <span>🫧</span>
        <span>Support Circles</span>
      </div>
      <a href="/circles" style="font-size: 0.8rem; color: var(--primary); font-weight: 600;">View all</a>
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      <% navCircles.slice(0, 3).forEach(circle => { %>
        <a href="/circles/<%= circle.id %>" style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem; border-radius: var(--radius-md); background-color: var(--bg-surface-subtle); transition: var(--transition);">
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span style="font-size: 1.2rem;"><%= circle.icon %></span>
            <div>
              <div style="font-weight: 700; font-size: 0.85rem;"><%= circle.name %></div>
              <div style="font-size: 0.75rem; color: var(--text-light);"><%= circle.memberCount %> members</div>
            </div>
          </div>
          <span style="font-size: 0.8rem; color: var(--primary);">➔</span>
        </a>
      <% }); %>
    </div>
  </div>

  <!-- 24/7 Crisis Lifeline Quick Card -->
  <div class="card crisis-box">
    <div style="display: flex; align-items: center; gap: 0.5rem; color: #dc2626; font-weight: 700; font-size: 0.9rem;">
      <span>🚨</span>
      <span>In Need of Immediate Help?</span>
    </div>
    <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.4rem;">
      If you are in immediate distress or having thoughts of self-harm, compassionate professionals are available right now.
    </p>
    <a href="/resources" class="crisis-btn">
      <span>📞 View 24/7 Helplines</span>
    </a>
  </div>
</aside>
